<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:layout_marginBottom="8dp"
    android:weightSum="4">

    <!-- Item 0 -->
    <LinearLayout
        android:id="@+id/item0_container"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp"
        android:layout_marginEnd="8dp">
        <TextView android:id="@+id/item0_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/item0_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Item 1 -->
    <LinearLayout
        android:id="@+id/item1_container"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp"
        android:layout_marginEnd="8dp">
        <TextView android:id="@+id/item1_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/item1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Item 2 -->
    <LinearLayout
        android:id="@+id/item2_container"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp"
        android:layout_marginEnd="8dp">
        <TextView android:id="@+id/item2_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/item2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Item 3 -->
    <LinearLayout
        android:id="@+id/item3_container"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_item_bg"
        android:padding="4dp">
        <TextView android:id="@+id/item3_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/item3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
